rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Enforce Metaspace Consult mandatory metadata tags on all Oghowa documents
    function hasMandatoryMetadata(data) {
      return data.parent_organization == 'Metaspace Consult'
        && data.initiative == 'Oghowa Accelerator & Business Week'
        && data.app_support == 'usiobaifovictory245@gmail.com';
    }

    // 1. ISOLATED SITE CONFIG (Single document: live_portal)
    match /oghowa_site_config/{docId} {
      allow read: if true;
      // Non-destructive write: must target live_portal and maintain metadata
      allow create, update: if docId == 'live_portal'
        && hasMandatoryMetadata(incoming());
      // Document deletion strictly prohibited
      allow delete: if false;
    }

    // 2. ISOLATED REGISTRATIONS
    match /oghowa_registrations/{registrationId} {
      allow read: if true;
      allow create: if isValidId(registrationId)
        && hasMandatoryMetadata(incoming())
        && incoming().fullName is string
        && incoming().email is string;
      allow update: if isValidId(registrationId)
        && hasMandatoryMetadata(incoming());
      // Prohibit client deletion without backend verification
      allow delete: if false;
    }

    // 3. ISOLATED EVENTS
    match /oghowa_events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId)
        && hasMandatoryMetadata(incoming());
      allow delete: if false;
    }

    // 4. ISOLATED DEAL ROOM DOSSIERS
    match /oghowa_dealroom_dossiers/{dossierId} {
      allow read: if true;
      allow create, update: if isValidId(dossierId)
        && hasMandatoryMetadata(incoming());
      allow delete: if false;
    }

    // Global Safety Net: Strictly deny access to all non-oghowa Metaspace Consult collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
