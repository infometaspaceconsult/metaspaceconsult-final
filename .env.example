# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Sync database with Supabase
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# RESEND API CONFIGURATION: Email notifications for bookings and inquiries
RESEND_API_KEY=""

# STANDARD SMTP CONFIGURATION: Robust Node-based mail transport
# Configure your SMTP mail server credentials for inquiry notifications
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Metaspace Consulting"
SMTP_FROM_EMAIL=""
NOTIFICATION_EMAIL="info@metaspaceconsulting.com"
