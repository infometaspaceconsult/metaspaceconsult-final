{
  "entities": {
    "site_config": {
      "title": "Site Configuration",
      "description": "Global website branding, hero texts, contact details, and social links",
      "type": "object",
      "properties": {
        "heroMainTitle": { "type": "string" },
        "heroSubTitle": { "type": "string" },
        "heroDescription": { "type": "string" },
        "companyEmail": { "type": "string" },
        "companyPhone": { "type": "string" },
        "companyAddress": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      }
    },
    "consultations": {
      "title": "Consultation Bookings",
      "description": "Consultation requests submitted by prospective clients and partners",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "organization": { "type": "string" },
        "sector": { "type": "string" },
        "service": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "scheduled", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "organization", "service"]
    },
    "contact_inquiries": {
      "title": "Contact Inquiries",
      "description": "General inquiries submitted via the Contact Us form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_progress", "resolved", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "ventures": {
      "title": "Portfolio Ventures",
      "description": "Ventures incubator portfolio items and metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "sector": { "type": "string" },
        "stage": { "type": "string" },
        "description": { "type": "string" },
        "stats": { "type": "string" }
      },
      "required": ["id", "name", "sector", "stage"]
    }
  },
  "firestoreRules": "firestore.rules"
}
